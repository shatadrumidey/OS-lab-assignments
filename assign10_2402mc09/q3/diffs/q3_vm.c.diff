+// Asg10 Q3: Get page information for a virtual address
+int
+pageinfo(uint va)
+{
+  pte_t *pte;
+  struct proc *cur = myproc();
+  
+  if(cur == 0)
+    return -1;
+  
+  // Walk the page table to find the PTE
+  pte = walkpgdir(cur->pgdir, (void*)va, 0);
+  
+  // If PTE doesn't exist, print unmapped
+  if(pte == 0){
+    cprintf("Page unmapped (no page table entry)\n");
+    return -1;
+  }
+  
+  // If page is not present
+  if((*pte & PTE_P) == 0){
+    cprintf("Page not present\n");
+    return -1;
+  }
+  
+  // Extract physical frame number and flags
+  uint pa = PTE_ADDR(*pte);
+  int p_flag = (*pte & PTE_P) ? 1 : 0;
+  int w_flag = (*pte & PTE_W) ? 1 : 0;
+  int u_flag = (*pte & PTE_U) ? 1 : 0;
+  
+  cprintf("Physical Frame: %x\n", pa);
+  cprintf("Flags: P=%d W=%d U=%d\n", p_flag, w_flag, u_flag);
+  
+  if(w_flag)
+    cprintf("Permissions: Read-Write\n");
+  else
+    cprintf("Permissions: Read-Only\n");
+  
+  return 0;
+}
+
+// Asg10 Q3: Set page to read-only by removing PTE_W flag
+int
+setreadonly(uint va)
+{
+  pte_t *pte;
+  struct proc *cur = myproc();
+  
+  if(cur == 0)
+    return -1;
+  
+  // Walk the page table to find the PTE
+  pte = walkpgdir(cur->pgdir, (void*)va, 0);
+  
+  // If PTE doesn't exist or not present
+  if(pte == 0 || (*pte & PTE_P) == 0){
+    cprintf("Page not mapped\n");
+    return -1;
+  }
+  
+  // Remove write permission
+  *pte = (*pte & ~PTE_W);
+  
+  cprintf("Page set to read-only\n");
+  return 0;
+}
