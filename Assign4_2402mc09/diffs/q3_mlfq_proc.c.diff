+// MLFQ: timer-tick handler. Quanta: level0=1, level1=2, level2=4 ticks.
+// Uses whole quantum without yielding -> demote + yield.
+void
+mlfq_tick(void)
+{
+  struct proc *cur = myproc();
+  int allot, demoted = 0;
+
+  if(cur == 0 || cur->state != RUNNING)
+    return;
+  if(holding(&ptable.lock))
+    return;
+
+  acquire(&ptable.lock);
+  cur->ticks_used++;
+  allot = 1 << cur->queue_level;
+  if(cur->ticks_used >= allot){
+    if(cur->queue_level < 2)
+      cur->queue_level++;          // penalize CPU-heavy process
+    cur->ticks_used = 0;
+    demoted = 1;
+  }
+  release(&ptable.lock);
+
+  if(demoted)
+    yield();
+}
+
+int
+get_queue_level(int pid)
+{
+  struct proc *p;
+  int lv = -1;
+
+  acquire(&ptable.lock);
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+    if(p->state != UNUSED && p->pid == pid){
+      lv = p->queue_level;
+      break;
+    }
+  }
+  release(&ptable.lock);
+  return lv;
+}
