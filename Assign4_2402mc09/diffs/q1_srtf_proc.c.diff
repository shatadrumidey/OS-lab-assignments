+// SRTF: unset remaining time counts as infinite => scheduled last
+static int
+eff_rem(struct proc *p)
+{
+  if(p->remaining_time < 0)
+    return 1000000000;
+  return p->remaining_time;
+}
+
+int
+set_burst(int pid, int bt)
+{
+  struct proc *p;
+
+  if(bt < 1)
+    return -1;
+  acquire(&ptable.lock);
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+    if(p->state != UNUSED && p->pid == pid){
+      p->burst_time = bt;
+      p->remaining_time = bt;     // countdown starts at the estimate
+      release(&ptable.lock);
+      return 0;
+    }
+  }
+  release(&ptable.lock);
+  return -1;
+}
+
+// SRTF: called on each timer tick from trap()
+void
+srtf_tick(void)
+{
+  struct proc *cur = myproc();
+  struct proc *q;
+  int preempt = 0;
+
+  if(cur == 0 || cur->state != RUNNING)
+    return;
+  if(holding(&ptable.lock))
+    return;
+  if(cur->remaining_time < 0){
+    yield();                      // undeclared burst -> default RR
+    return;
+  }
+
+  acquire(&ptable.lock);
+  if(cur->remaining_time > 0)
+    cur->remaining_time--;        // (d) decrement running process
+  for(q = ptable.proc; q < &ptable.proc[NPROC]; q++){
+    if(q->state == RUNNABLE && eff_rem(q) < eff_rem(cur)){
+      preempt = 1;                // (d) strictly smaller waiter exists
+      break;
+    }
+  }
+  release(&ptable.lock);
+
+  if(preempt)
+    yield();
+}
