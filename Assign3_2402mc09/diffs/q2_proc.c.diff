+// Lab 3 Q2: change a process's priority (1 = highest .. 20 = lowest)
+int
+set_priority(int pid, int priority)
+{
+  struct proc *p;
 
+  if(priority < 1 || priority > 20)
+    return -1;
+  acquire(&ptable.lock);
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+    if(p->state != UNUSED && p->pid == pid){
+      p->priority = priority;
+      release(&ptable.lock);
+      return 0;
+    }
+  }
+  release(&ptable.lock);
+  return -1;
+}
