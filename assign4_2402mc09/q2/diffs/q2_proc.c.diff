+// Asg4 Q2: declare expected burst time for a process
+int
+set_burst(int pid, int bt)
+{
+  struct proc *p;
+  int found = 0;
+  if(bt < 1)
+    return -1;
+  acquire(&ptable.lock);
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+    if(p->pid == pid){
+      p->burst_time = bt;
+      found = 1;
+      break;
+    }
+  }
+  release(&ptable.lock);
+  return found ? 0 : -1;
+}
