+// Asg4 Q3: report the queue level of a process (-1 if not found)
+int
+get_queue_level(int pid)
+{
+  struct proc *p;
+  int lvl = -1;
+  acquire(&ptable.lock);
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+    if(p->pid == pid){
+      lvl = p->queue_level;
+      break;
+    }
+  }
+  release(&ptable.lock);
+  return lvl;
+}
