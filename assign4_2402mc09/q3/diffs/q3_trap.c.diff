   // Force process to give up CPU on clock tick.
   // If interrupts were on while locks held, would need to check nlock.
+  // Asg4 Q3: MLFQ time-slice accounting and demotion
   if(myproc() && myproc()->state == RUNNING &&
-     tf->trapno == T_IRQ0+IRQ_TIMER)
+     tf->trapno == T_IRQ0+IRQ_TIMER){
+    struct proc *mp = myproc();
+    int quantum;
+    mp->ticks_used++;
+    if(mp->queue_level == 0)      quantum = 1;
+    else if(mp->queue_level == 1) quantum = 2;
+    else                          quantum = 4;
+    if(mp->ticks_used >= quantum){
+      if(mp->queue_level < 2)
+        mp->queue_level++;   // used full slice -> demote
+      mp->ticks_used = 0;
+    }
     yield();
+  }
 
