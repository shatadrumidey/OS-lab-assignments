+// HRRN: response ratio * 100 with integer arithmetic
+static int
+resp_ratio(struct proc *p)
+{
+  int wait, burst;
+
+  if(p->burst_time <= 0)
+    return 0;                      // unset burst -> scheduled last
+  wait = ticks - p->ctime;
+  if(wait < 0)
+    wait = 0;
+  burst = p->burst_time;
+  return ((wait + burst) * 100) / burst;
+}
+
+int
+set_burst(int pid, int bt)
+{
+  struct proc *p;
+
+  if(bt < 1)
+    return -1;
+  acquire(&ptable.lock);
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+    if(p->state != UNUSED && p->pid == pid){
+      p->burst_time = bt;
+      release(&ptable.lock);
+      return 0;
+    }
+  }
+  release(&ptable.lock);
+  return -1;
+}
